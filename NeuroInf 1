        "# RECONSTRUCTION\n",
        "from sklearn.decomposition import sparse_encode\n",
        "\n",
        "random_patch = patches[random.randrange(len(patches))]\n",
        "n_basis_to_use = min(n_basis, basis.shape[0])\n",
        "reconstructions = []\n",
        "\n",
        "\n",
        "def sparse_coding_reconstruction(random_patch, basis, reconstructions, n_basis):\n",
        "    centered_patch = (random_patch - patch_mean)[None, :]\n",
        "\n",
        "    # Die Koeffizienten einmal mit dem gesamten Dictionary berechnen.\n",
        "    coefficients = sparse_encode(centered_patch, basis, n_jobs=-1)[0]\n",
        "    ranked_indices = np.argsort(-np.abs(coefficients))\n",
        "\n",
        "    for i in range(1, n_basis + 1):\n",
        "        indices = ranked_indices[:i]\n",
        "        x_recon = coefficients[indices] @ basis[indices] + patch_mean\n",
        "        reconstructions.append(x_recon)\n",
        "\n",
        "    return reconstructions\n",
        "\n",
        "\n",
        "def linear_reconstruction(random_patch, basis, reconstructions, n_basis):\n",
        "    centered_patch = random_patch - model.mean_\n",
        "\n",
        "    for i in range(1, n_basis + 1):\n",
        "        selected_basis = basis[:i]\n",
        "        inverse_basis = np.linalg.pinv(selected_basis)\n",
        "        coefficients = centered_patch @ inverse_basis\n",
        "        x_recon = coefficients @ selected_basis + model.mean_\n",
        "        reconstructions.append(x_recon)\n",
        "\n",
        "    return reconstructions\n",
        "\n",
        "\n",
        "if method == \"sc\":\n",
        "    reconstructions = sparse_coding_reconstruction(\n",
        "        random_patch, basis, reconstructions, n_basis_to_use\n",
        "    )\n",
        "else:\n",
        "    reconstructions = linear_reconstruction(\n",
        "        random_patch, basis, reconstructions, n_basis_to_use\n",
        "    )\n",
        "\n",
        "reconstructions = np.stack(reconstructions)\n",
        "\n",
        "print(\"Ursprünglicher Patch\")\n",
        "show_in_grid(random_patch[None, :], patch_size, patch_size)\n",
        "\n",
        "print(f\"Rekonstruktionen mit bis zu {n_basis_to_use} Basisvektoren\")\n",
        "show_in_grid(reconstructions, patch_size, patch_size)"
      ]
