      "source": [
        "## Compute and show the principal components\n",
        "\n",
        "# Datensatz laden und in Gleitkommazahlen umwandeln\n",
        "with np.load(dataset) as archive:\n",
        "    data = archive[\"data\"].astype(np.float64)\n",
        "\n",
        "# Eine Zeile pro Bild, eine Spalte pro Pixel\n",
        "data = data.reshape(data.shape[0], -1)\n",
        "n_images, n_pixels = data.shape\n",
        "\n",
        "# Seitenlänge der quadratischen Bilder berechnen\n",
        "img_height = math.isqrt(n_pixels)\n",
        "img_width = img_height\n",
        "assert img_height * img_width == n_pixels, \"Die Bilder müssen quadratisch sein.\"\n",
        "\n",
        "# Jedes Bild um seinen mittleren Grauwert zentrieren\n",
        "mean_free_data = data - data.mean(axis=1, keepdims=True)\n",
        "\n",
        "# Zufällige Bildausschnitte ziehen\n",
        "patches = random_patches(\n",
        "    mean_free_data, img_height, img_width, n_patches, patch_size\n",
        ")\n",
        "\n",
        "# Basisvektoren berechnen oder laden\n",
        "if method == \"pca\":\n",
        "    model = PCA(n_components=n_basis, random_state=0).fit(patches)\n",
        "    basis = model.components_\n",
        "\n",
        "elif method == \"ica\":\n",
        "    model = FastICA(\n",
        "        n_components=n_basis,\n",
        "        whiten=\"unit-variance\",\n",
        "        random_state=0,\n",
        "    ).fit(patches)\n",
        "    basis = model.mixing_.T\n",
        "\n",
        "elif method == \"sc\":\n",
        "    patch_mean = patches.mean(axis=0)\n",
        "    centered_patches = patches - patch_mean\n",
        "\n",
        "    if SC_LOAD_DICTIONARY:\n",
        "        basis = np.load(\"data/sc_basis.npy\")\n",
        "    else:\n",
        "        model = DictionaryLearning(\n",
        "            n_components=n_basis,\n",
        "            max_iter=n_iterations,\n",
        "            n_jobs=-1,\n",
        "            verbose=True,\n",
        "            random_state=0,\n",
        "        ).fit(centered_patches)\n",
        "        basis = model.components_\n",
        "\n",
        "else:\n",
        "    raise ValueError(f\"Unbekannte Methode: {method!r}\")\n",
        "\n",
        "# Die ersten n_basis Basisvektoren anzeigen\n",
        "show_in_grid(basis[:n_basis], patch_size, patch_size)"
      ]
